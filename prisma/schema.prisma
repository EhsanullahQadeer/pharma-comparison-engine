// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Roadmap §4 "Staff roles" table.
enum StaffRole {
  CATALOGUE_EDITOR
  CONTENT_REVIEWER
  ADMINISTRATOR
  COMMERCIAL_MANAGER
}

// M3b state machine: discovered -> identity verified -> ED catalogue verified -> published -> temporarily withheld / archived.
// Every transition is a deliberate staff action; nothing auto-publishes a first-time provider.
enum ProviderStatus {
  DISCOVERED
  IDENTITY_VERIFIED
  ED_CATALOGUE_VERIFIED
  PUBLISHED
  TEMPORARILY_WITHHELD
  ARCHIVED
}

enum RegulatorType {
  GPHC
  PSNI
}

enum Ingredient {
  SILDENAFIL
  TADALAFIL
}

enum SupplyClassification {
  POM
  P
  GSL
}

enum Availability {
  IN_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

enum PurchaseModel {
  ONE_OFF
  RECURRING
}

enum DiscountValueType {
  PERCENT
  FIXED_AMOUNT
}

// A delivery policy or discount the scraper read from a pharmacy's own website. Nothing found this
// way is applied or shown publicly until a staff member approves it; a dismissed row is kept so
// the same finding isn't suggested again on the next check.
enum ScrapeReviewStatus {
  PENDING
  APPROVED
  DISMISSED
}

enum EvidenceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// DRAFT → IN_REVIEW → PUBLISHED. Only a reviewer who isn't the author can publish; any edit to a
// published article sends it back to IN_REVIEW (a new revision needs a fresh clinical review).
enum ArticleStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

enum PublicSubmissionKind {
  PHARMACY_SUGGESTION
  CONTACT
}

enum PublicSubmissionStatus {
  NEW
  HANDLED
  SPAM
}

enum CorrectionStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// M3b automatic discovery (see docs/pharmacy-discovery-research-review.md, which reconciles the
// raw source research against reality — GPHC and NHSBSA_CONTRACTOR_DETAILS have unconfirmed live
// schemas as of 2026-09-16 and are registered slots only; their adapters are stubs until verified.
enum DiscoverySourceType {
  MANUAL_WEB
  COMPANIES_HOUSE
  CQC
  NHS_ODS
  NHSBSA_CONTRACTOR_DETAILS
  GPHC
}

enum DiscoveryCadence {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum DiscoveryRunStatus {
  SUCCESS
  FAILURE
  PARTIAL
}

// A candidate is never auto-merged into a Provider — per the research-review doc's explicit
// rejection of score-based auto-approval, every NEW/LINKED_EXISTING candidate needs a staff click
// before any Provider data changes.
enum DiscoveryCandidateStatus {
  NEW
  LINKED_EXISTING
  PROMOTED
  REJECTED
}

// The whole dedup mechanism is an exact match against one of these on ProviderIdentifier — no
// fuzzy/scored matching. GPhC number identifies a premises only, not a universal join key across
// sources (research-review doc) — kept alongside the others as one of several identifier types.
enum ProviderIdentifierType {
  COMPANY_NUMBER
  CQC_LOCATION_ID
  ODS_CODE
  GPHC_NUMBER
}

// Product-base filter pilot (2026-09-18, ED-only — see docs/current-tasks.md): which ProductVariant
// a provider's website appears to sell, detected from its own public pages, always staff-confirmed
// before an Offer is created — same never-auto-write rule as DiscoveryCandidate.
enum ProductMatchStatus {
  NEW
  CONFIRMED
  REJECTED
}

// HIGH: the matched ingredient token sits in the URL's final path segment (a specific product/
// treatment page, e.g. /treatments/viagra-connect). MEDIUM: the token only appears in an earlier
// path segment (a category/collection page, e.g. /treatments?condition=ed) — per the "dedicated
// page = confirmed, category mention = probable" rule in docs/implementation-plan.md §6.
enum ProductMatchConfidence {
  HIGH
  MEDIUM
}

enum PriceScrapeCadence {
  MANUAL
  DAILY
  WEEKLY
  MONTHLY
}

enum PriceScrapeStatus {
  NOT_CONFIGURED
  READY
  SCRAPED
  NEEDS_REVIEW
  HUMAN_VERIFICATION_REQUIRED
  FAILED
}

enum PriceCollectionJobStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  HUMAN_VERIFICATION_REQUIRED
}

model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         StaffRole
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reviewedEvidence            Evidence[]           @relation("EvidenceReviewer")
  authoredArticles            Article[]            @relation("ArticleAuthor")
  reviewedArticles            Article[]            @relation("ArticleReviewer")
  handledSubmissions          PublicSubmission[]   @relation("PublicSubmissionHandler")
  ownedCorrections            Correction[]         @relation("CorrectionOwner")
  auditLogs                   AuditLog[]           @relation("AuditLogActor")
  triggeredDiscoveryRuns      DiscoveryRun[]       @relation("DiscoveryRunTrigger")
  reviewedDiscoveryCandidates DiscoveryCandidate[] @relation("DiscoveryCandidateReviewer")
  reviewedProductMatches      ProductMatch[]       @relation("ProductMatchReviewer")
}

// Trading/legal names, website, regulator references, dispensing partner, service regions (roadmap §4).
// Kept as one flat record for M3a; M3b's fuller identity-resolution model (separate legal entity /
// trading brand / domain / premises records for multi-brand dispensers) is a later refinement, not
// required for the first manual-entry + discovery pass.
model Provider {
  id                    String         @id @default(cuid())
  legalName             String
  tradingName           String
  websiteDomain         String         @unique
  regulatorType         RegulatorType
  regulatorReference    String
  dispensingPartnerName String?
  serviceRegions        String[]
  status                ProviderStatus @default(DISCOVERED)
  affiliateApproved     Boolean        @default(false)
  // Path under /public (e.g. /pharmacy-logos/boots-com.png) or an https URL; null shows a monogram.
  logoUrl               String?
  // When this pharmacy's own website was last read for its delivery charge and discount offers.
  siteOffersCheckedAt   DateTime?
  // Shopper-facing facts staff record from the pharmacy's own site and public registers, each
  // group with the date it was last checked so stale facts can be flagged like prices. Null =
  // not recorded (shown as unknown, never as "no").
  trustpilotUrl              String?
  // Score × 10 (4.8 → 48), integers like every other figure. Only shown publicly once
  // SHOW_TRUSTPILOT_SCORES is switched on (Trustpilot's terms first).
  trustpilotScoreTenths      Int?
  trustpilotReviewCount      Int?
  trustpilotCheckedAt        DateTime?
  inspectionOutcome          InspectionOutcome?
  inspectionDate             DateTime?
  inspectionCheckedAt        DateTime?
  nextDayDelivery            Boolean?
  discreetPackaging          Boolean?
  paymentMethods             PaymentMethod[]
  serviceFactsCheckedAt      DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  offers              Offer[]
  discounts           Discount[]
  deliveryPolicies    DeliveryPolicy[]
  evidence            Evidence[]
  corrections         Correction[]
  identifiers         ProviderIdentifier[]
  discoveryCandidates DiscoveryCandidate[]
  productMatches      ProductMatch[]
  referralClicks      ReferralClick[]
  affiliateProgramme  AffiliateProgramme?

  @@index([status])
}

// The canonical catalogue of ingredient/brand/strength/pack combinations. Provider-agnostic —
// Offer is what links a Provider to a ProductVariant with a price.
model ProductVariant {
  id                   String               @id @default(cuid())
  ingredient           Ingredient
  brandName            String?
  strengthMg           Int
  formulation          String
  packQuantity         Int
  supplyClassification SupplyClassification
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  offers         Offer[]
  productMatches ProductMatch[]
  referralClicks ReferralClick[]
}

// Money stored as integer pence per roadmap §4 "Fair price calculation" — never float.
model Offer {
  id                      String         @id @default(cuid())
  providerId              String
  provider                Provider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  productVariantId        String
  productVariant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  itemPricePence          Int
  deliveryFeePence        Int            @default(0)
  consultationFeePence    Int            @default(0)
  otherMandatoryFeesPence Int            @default(0)
  deliveryAssumption      String
  availability            Availability   @default(UNKNOWN)
  purchaseModel           PurchaseModel  @default(ONE_OFF)
  billingPeriodDays       Int?
  sourceUrl               String
  retrievedAt             DateTime
  priceVerifiedAt         DateTime?
  feeVerifiedAt           DateTime?
  publishedAt             DateTime?
  nextDueAt               DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  discounts      Discount[]
  priceHistory   PriceHistory[]
  evidence       Evidence[]
  referralClicks ReferralClick[]
  productMatch   ProductMatch?

  @@index([providerId])
  @@index([productVariantId])
}

// Belongs to exactly one of an Offer (staff-entered, for that price) or a Provider (site-wide,
// applies to all of that pharmacy's offers) — enforced at the application layer.
model Discount {
  id           String             @id @default(cuid())
  offerId      String?
  offer        Offer?             @relation(fields: [offerId], references: [id], onDelete: Cascade)
  providerId   String?
  provider     Provider?          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  eligibility  String
  // Optional code the customer enters at the pharmacy's checkout; null when it applies automatically.
  code         String?
  valueType    DiscountValueType
  valuePence   Int?
  valuePercent Int?
  stackable    Boolean            @default(false)
  expiresAt    DateTime?
  // Staff-entered discounts are approved from the start; scraped ones wait for a staff decision.
  status       ScrapeReviewStatus @default(APPROVED)
  scraped      Boolean            @default(false)
  // The wording on the pharmacy's website a scraped discount was read from, and where.
  evidenceText String?
  sourceUrl    String?
  lastSeenAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  evidence Evidence[]

  @@index([offerId])
  @@index([providerId])
}

// A pharmacy's standard UK delivery charge as read from its own website. Once approved it sets the
// delivery fee on that pharmacy's offers; at most one row per provider is APPROVED.
model DeliveryPolicy {
  id               String             @id @default(cuid())
  providerId       String
  provider         Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  standardFeePence Int
  // Orders at or above this item price are delivered free; null when there is no such threshold.
  freeOverPence    Int?
  evidenceText     String
  sourceUrl        String
  status           ScrapeReviewStatus @default(PENDING)
  lastSeenAt       DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([providerId, status])
}

// Source URL, retrieved date, checked date, reviewer and approved status (roadmap §4). Attaches to
// exactly one of Provider / Offer / Discount / Article — enforced at the application layer since
// Prisma has no native polymorphic relation.
model Evidence {
  id             String                 @id @default(cuid())
  sourceUrl      String
  retrievedAt    DateTime
  checkedAt      DateTime?
  reviewerId     String?
  reviewer       StaffUser?             @relation("EvidenceReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  approvedStatus EvidenceApprovalStatus @default(PENDING)
  providerId     String?
  provider       Provider?              @relation(fields: [providerId], references: [id], onDelete: Cascade)
  offerId        String?
  offer          Offer?                 @relation(fields: [offerId], references: [id], onDelete: Cascade)
  discountId     String?
  discount       Discount?              @relation(fields: [discountId], references: [id], onDelete: Cascade)
  articleId      String?
  article        Article?               @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt      DateTime               @default(now())
}

// A full offer-state snapshot written on every accepted change to an offer's price, fees,
// availability or active discount — not just the price number. Originally price-only; broadened
// 2026-09-16 (platform pivot, M3a reopened item) because the roadmap's own failure scenarios
// (§4.7: disputed/expired discounts, feed-vs-visible-price mismatches) need to show *why* a
// delivered total changed, not just that it did. `activeDiscountSnapshot` is a point-in-time copy
// of the discount terms that applied (if any) — not a live relation, since the Discount row itself
// may later change or be deleted.
model PriceHistory {
  id                      String       @id @default(cuid())
  offerId                 String
  offer                   Offer        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  itemPricePence          Int
  deliveryFeePence        Int          @default(0)
  consultationFeePence    Int          @default(0)
  otherMandatoryFeesPence Int          @default(0)
  deliveredTotalPence     Int
  availability            Availability @default(UNKNOWN)
  activeDiscountSnapshot  Json?
  effectiveFrom           DateTime
  recordedAt              DateTime     @default(now())

  @@index([offerId])
}

model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  topic       String
  language    String        @default("en")
  sources     String[]
  // Markdown (GFM). Rendered without raw HTML.
  body        String        @default("")
  summary     String        @default("")
  keyFacts    String[]
  // Reviewer's notes when returning an article to the author.
  reviewNotes String?
  revision    Int           @default(1)
  status      ArticleStatus @default(DRAFT)
  // Staff on/off switch, separate from status: an inactive article is never shown publicly.
  active      Boolean       @default(true)
  authorId    String
  author      StaffUser     @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewerId  String?
  reviewer    StaffUser?    @relation("ArticleReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  evidence Evidence[]
}

model Correction {
  id              String           @id @default(cuid())
  reportedIssue   String
  reporterEmail   String?
  providerId      String?
  provider        Provider?        @relation(fields: [providerId], references: [id], onDelete: SetNull)
  assignedOwnerId String?
  assignedOwner   StaffUser?       @relation("CorrectionOwner", fields: [assignedOwnerId], references: [id], onDelete: SetNull)
  status          CorrectionStatus @default(OPEN)
  resolution      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

enum AffiliateNetwork {
  AWIN
  CJ
  IMPACT
  DIRECT
  OTHER
}

enum AffiliateProgrammeStatus {
  APPLIED
  ACTIVE
  PAUSED
  REJECTED
  ENDED
}

enum CommissionBasis {
  FIXED
  PERCENT
}

// A pharmacy's affiliate programme (referral-earnings-plan Phase 2), one per pharmacy. Only an
// ACTIVE programme changes anything public: /go then sends the visitor through linkTemplate instead
// of the plain product URL. Activation requires recorded evidence that the programme permits price
// comparison of prescription-only ED medicines. Never read by ranking code.
model AffiliateProgramme {
  id                    String                   @id @default(cuid())
  providerId            String                   @unique
  provider              Provider                 @relation(fields: [providerId], references: [id], onDelete: Cascade)
  network               AffiliateNetwork
  networkMerchantId     String?
  status                AffiliateProgrammeStatus @default(APPLIED)
  // https URL with {url} (the offer's product page, URL-encoded) and optional {clickRef} placeholders.
  linkTemplate          String
  commissionBasis       CommissionBasis
  // Pence when FIXED, basis points (1/100 of a percent) when PERCENT.
  commissionValue       Int
  attributionDays       Int?
  termsUrl              String?
  termsNotes            String?
  pomPromotionPermitted Boolean                  @default(false)
  activatedAt           DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  clicks ReferralClick[]

  @@index([status])
}

// Where on the public site an outbound "view at pharmacy" click came from.
enum ReferralPlacement {
  COMPARE
  INGREDIENT_PRICES
  PHARMACY_PROFILE
  REPEAT_COSTS
}

enum ClickDevice {
  DESKTOP
  MOBILE
  TABLET
}

// One row per outbound click through /go/[offerId] (M7). Deliberately non-identifying (roadmap
// §2.10): no IP, raw user agent or cookie. visitorHash is a salted daily hash used only
// to spot repeat-click bots, and is cleared after 24h. The destination isn't stored — it's always
// the offer's own validated sourceUrl at click time. Never read by ranking code.
model ReferralClick {
  id               String              @id @default(cuid())
  offerId          String?
  offer            Offer?              @relation(fields: [offerId], references: [id], onDelete: SetNull)
  providerId       String
  provider         Provider            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  productVariantId String?
  productVariant   ProductVariant?     @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  // Set when the click went through an ACTIVE programme's tracked link; the click id is the clickRef.
  programmeId      String?
  programme        AffiliateProgramme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  placement        ReferralPlacement?
  rankPosition     Int?
  isLikelyBot      Boolean             @default(false)
  visitorHash      String?
  // Marketing detail, all derived at click time and null when unknown. The area comes from the
  // host's lookup of the IP (which is then discarded); device, browser and system are the three
  // coarse labels read from the user agent, never the string itself.
  country          String?
  region           String?
  city             String?
  deviceType       ClickDevice?
  browser          String?
  os               String?
  // The page of ours the visitor clicked from, with its filters (path and query, no origin).
  sourcePath       String?
  // What the visitor was shown: the offer's total to pay at the moment of the click.
  totalPricePence  Int?
  // Set only for clicks from a phone price-grid layout (the A/B test); null everywhere else.
  gridLayout       GridLayout?
  createdAt        DateTime            @default(now())

  @@index([createdAt])
  @@index([providerId, createdAt])
  @@index([visitorHash, createdAt])
}

// Generic "who changed what, when" trail for every model — separate from PriceHistory, which only
// records accepted offer-price changes for the price engine. entityType/entityId are a string
// pair (not a Prisma relation) since one log must be able to point at any model in this schema;
// enforced/interpreted at the application layer, same approach as Evidence's polymorphic parent.
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      StaffUser?  @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String
  entityId   String
  changes    Json?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// One row per discovery data source, seeded once (prisma/seed.ts) — not staff-creatable, only
// staff-editable (cadence/enabled). Admin-configurable cadence per client instruction: fetch
// frequency is a setting, not a hardcoded cron.
model DiscoverySource {
  id                       String              @id @default(cuid())
  type                     DiscoverySourceType @unique
  enabled                  Boolean             @default(false)
  cadence                  DiscoveryCadence
  lastRunAt                DateTime?
  nextRunAt                DateTime?
  config                   Json?
  // Encrypted credentials ("<iv>:<authTag>:<ciphertext>", all base64 via
  // src/lib/discovery/credentials-crypto.ts) — never plaintext, never sent to the client.
  // configuredCredentialKeys holds just the key *names* (e.g. "apiKey") kept in lockstep with the
  // ciphertext, so the admin UI can show "configured"/"not set" per field without ever decrypting.
  credentialsCiphertext    String?
  configuredCredentialKeys String[]            @default([])
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  runs       DiscoveryRun[]
  candidates DiscoveryCandidate[]

  @@index([enabled, nextRunAt])
}

// One row per adapter execution — system/cron activity, not a staff-driven entity mutation, so
// kept separate from AuditLog. triggeredByStaffId is null for a cron-fired run, set for a manual
// "Run now" click.
model DiscoveryRun {
  id                 String              @id @default(cuid())
  sourceId           String
  source             DiscoverySource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  startedAt          DateTime            @default(now())
  finishedAt         DateTime?
  status             DiscoveryRunStatus?
  candidatesFound    Int                 @default(0)
  errorMessage       String?
  // The primary request the adapter made, secrets replaced with a "{name}" placeholder — never a
  // real key/value. Kept even on failed runs ("here's exactly what we tried to call").
  requestSummary     String?
  triggeredByStaffId String?
  triggeredByStaff   StaffUser?          @relation("DiscoveryRunTrigger", fields: [triggeredByStaffId], references: [id], onDelete: SetNull)
  createdAt          DateTime            @default(now())

  touchedCandidates DiscoveryCandidate[]

  @@index([sourceId, startedAt])
}

// One row per raw discovered record pending staff resolution. sourceRecordId is the source's own
// key (company number / CQC location id / ODS code) so re-ingesting the same record upserts rather
// than duplicating. Identifiers found on the raw record are copied out to their own columns so
// identifier-match.ts can do a plain indexed lookup against ProviderIdentifier without touching
// rawPayload.
model DiscoveryCandidate {
  id                String                   @id @default(cuid())
  sourceId          String
  source            DiscoverySource          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceRecordId    String
  rawPayload        Json
  name              String
  postcode          String?
  websiteDomain     String?
  companyNumber     String?
  cqcLocationId     String?
  odsCode           String?
  gphcNumber        String?
  status            DiscoveryCandidateStatus @default(NEW)
  matchedProviderId String?
  matchedProvider   Provider?                @relation(fields: [matchedProviderId], references: [id], onDelete: SetNull)
  reviewedByStaffId String?
  reviewedByStaff   StaffUser?               @relation("DiscoveryCandidateReviewer", fields: [reviewedByStaffId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  // Which run most recently created/updated this candidate — lets a "Run now" click query exactly
  // what that run found, rather than guessing from timestamps.
  lastSeenRunId     String?
  lastSeenRun       DiscoveryRun?            @relation(fields: [lastSeenRunId], references: [id], onDelete: SetNull)
  discoveredAt      DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([sourceId, sourceRecordId])
  @@index([status])
  @@index([websiteDomain])
}

// The entire dedup mechanism: an exact match on (identifierType, value) is the whole "is this a
// duplicate" check — no fuzzy/scored matching (research-review doc explicitly rejects that for
// first publication). source is nullable since a staff member can also record an identifier by
// hand, not only via a discovery run.
model ProviderIdentifier {
  id             String                 @id @default(cuid())
  providerId     String
  provider       Provider               @relation(fields: [providerId], references: [id], onDelete: Cascade)
  identifierType ProviderIdentifierType
  value          String
  source         DiscoverySourceType?
  recordedAt     DateTime               @default(now())

  @@unique([identifierType, value])
  @@index([providerId])
}

// One row per candidate "this provider appears to sell this product" signal, found by
// src/lib/product-detection scanning a provider's own public pages — never auto-written into an
// Offer. Confirming picks the exact ProductVariant; the priced Offer itself is created later by the
// price-collection pilot's first successful scrape (offerId links back once that happens), not at
// confirm time — an Offer requires a real price and this step never has one yet.
// A staff-entered offer instead creates/claims its CONFIRMED match at save time
// (src/lib/price-collection/offer-product-match.ts).
model ProductMatch {
  id                  String                 @id @default(cuid())
  providerId          String
  provider            Provider               @relation(fields: [providerId], references: [id], onDelete: Cascade)
  candidateUrl        String
  matchedIngredient   Ingredient
  matchedTokens       String[]
  confidence          ProductMatchConfidence
  status              ProductMatchStatus     @default(NEW)
  productVariantId    String?
  productVariant      ProductVariant?        @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  offerId             String?                @unique
  offer               Offer?                 @relation(fields: [offerId], references: [id], onDelete: SetNull)
  priceCollectionJobs PriceCollectionJob[]
  reviewedByStaffId   String?
  reviewedByStaff     StaffUser?             @relation("ProductMatchReviewer", fields: [reviewedByStaffId], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?
  scrapeEnabled       Boolean                @default(false)
  scrapeCadence       PriceScrapeCadence     @default(MANUAL)
  nextScrapeAt        DateTime?
  lastScrapedAt       DateTime?
  lastScrapeStatus    PriceScrapeStatus      @default(NOT_CONFIGURED)
  lastScrapeError     String?
  requiresHumanAssist Boolean                @default(false)
  detectedAt          DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  // One match per page per exact variant, so a page listing several strengths/pack sizes can carry a
  // confirmed match (and linked offer) for each. Undecided detection rows have no variant yet; code
  // checks for any match on a page before adding one (Postgres treats NULL variants as distinct).
  @@unique([providerId, candidateUrl, productVariantId])
  @@index([status])
  @@index([scrapeEnabled, nextScrapeAt])
}

model PriceCollectionJob {
  id             String                   @id @default(cuid())
  productMatchId String
  productMatch   ProductMatch             @relation(fields: [productMatchId], references: [id], onDelete: Cascade)
  status         PriceCollectionJobStatus @default(QUEUED)
  scheduledFor   DateTime
  startedAt      DateTime?
  finishedAt     DateTime?
  errorMessage   String?
  humanAssist    Boolean                  @default(false)
  // Claims made so far (first run + retries). A claim sets a lease; a RUNNING job whose lease has
  // expired belonged to a worker that died mid-run and is requeued (or failed once out of attempts).
  attempts       Int                      @default(0)
  leaseExpiresAt DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([status, scheduledFor])
  @@index([status, leaseExpiresAt])
  @@index([productMatchId])
}

// Messages from the public site that aren't listing corrections (those go to Correction):
// "suggest a pharmacy" and the general contact form. Staff triage them in /admin/inbox.
model PublicSubmission {
  id                 String                 @id @default(cuid())
  kind               PublicSubmissionKind
  status             PublicSubmissionStatus @default(NEW)
  name               String?
  email              String?
  subject            String?
  message            String
  pharmacyName       String?
  websiteUrl         String?
  regulatorReference String?
  handledById        String?
  handledBy          StaffUser?             @relation("PublicSubmissionHandler", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt          DateTime?
  createdAt          DateTime               @default(now())

  @@index([kind, status])
}

// GPhC inspection outcomes: the current two, plus the older four-level ratings still shown for
// pharmacies not re-inspected since.
enum InspectionOutcome {
  STANDARDS_MET
  STANDARDS_NOT_ALL_MET
  EXCELLENT
  GOOD
  SATISFACTORY
  POOR
}

enum PaymentMethod {
  CARD
  APPLE_PAY
  GOOGLE_PAY
  PAYPAL
  KLARNA
}

// "Email me when <product> <strength> × <pack> costs £X or less." Double opt-in: nothing is sent
// except the confirmation until confirmedAt is set, and unconfirmed rows are deleted after 48h.
// Holds an email address and nothing about the person's health beyond the product they chose.
model PriceAlert {
  id                String    @id @default(cuid())
  email             String
  // An EdProduct slug (src/lib/ed-products.ts), e.g. "generic-sildenafil".
  productSlug       String
  strengthMg        Int
  packQuantity      Int
  // Alert when the lowest in-stock delivered total is at or below this.
  thresholdPence    Int
  // Random secret in the confirm / manage links; the only way to act on an alert.
  token             String    @unique
  confirmedAt       DateTime?
  lastNotifiedAt    DateTime?
  lastNotifiedPence Int?
  createdAt         DateTime  @default(now())

  @@index([email])
  @@index([confirmedAt])
}

// The two phone price-grid layouts being compared (A: compact table, B: swipe columns).
enum GridLayout {
  COMPACT
  SWIPE
}

// Phone page views of the price grid, as a daily total per layout — the denominator for the A/B
// test's click-through rate. Deliberately a bare counter: nothing about the visitor is stored, and
// nothing is stored on their device (layouts alternate by week instead of per visitor).
model GridLayoutView {
  day    DateTime   @db.Date
  layout GridLayout
  views  Int        @default(0)

  @@id([day, layout])
}
